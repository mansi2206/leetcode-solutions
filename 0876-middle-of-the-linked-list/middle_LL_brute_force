// TC - O(N)
//SC - O(1)
// Middle of a Linked List
// ODD CASE
// input -> ll = 1 2 3 NULL
// output -> 2
// EVEN CASE
// input -> ll = 1 2 3 4 NULL
// output -> 3

#include <iostream>
using namespace std;

class Node
{
public:
    int data;
    Node *next;

    Node(int val)
    {
        data = val;
        next = NULL;
    }
};

class List
{
public:
    Node *head;
    List()
    {
        head = NULL;
    }

    void insert(int val)
    {
        Node *newNode = new Node(val);

        if (head == NULL)
        {
            head = newNode;
            return;
        }
        Node *temp = head;
        while (temp->next != NULL)
        {
            temp = temp->next;
        }
        temp->next = newNode;
    }

    void printLL()
    {
        Node *temp = head;
        while (temp != NULL)
        {
            cout << temp->data << "->";
            temp = temp->next;
        }
        cout << "NULL" << endl;
    }

    // Function to find the middle node of the linked list -- has node return type
    Node *middleLL()
    {
        int size = 0;
        Node *temp = head;
        while (temp != NULL)
        {
            temp = temp->next;
            size++;
        }
        int midPos = size / 2 + 1;
        temp = head;

        for (int i = 1; i < midPos; i++)
        {
            temp = temp->next;
        }
        cout << "Middle element: " << temp->data << endl;
        return temp;
    }
};
int main()
{
    List ll;
    ll.insert(1);
    ll.insert(2);
    ll.insert(3);
    ll.insert(4);
    // printing original Linked list
    ll.printLL();
    // return the node from the middle of the linked list
    Node *middle = ll.middleLL();

    while (middle != NULL)
    {
        cout << middle->data << " ";
        middle = middle->next;
    }

    return 0;
}
