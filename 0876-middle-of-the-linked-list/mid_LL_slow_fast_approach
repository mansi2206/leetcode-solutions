// Middle of a Linked List -- using slow & fast approach
// TC - O(N)
//SC - O(1)
#include <iostream>
using namespace std;

class Node
{
public:
    int data;
    Node *next;

    Node(int val)
    {
        data = val;
        next = NULL;
    }
};

class List
{
public:
    Node *head;
    List()
    {
        head = NULL;
    }

    void insert(int val)
    {
        Node *newNode = new Node(val);

        if (head == NULL)
        {
            head = newNode;
            return;
        }
        Node *temp = head;
        while (temp->next != NULL)
        {
            temp = temp->next;
        }
        temp->next = newNode;
    }

    void printLL()
    {
        Node *temp = head;
        while (temp != NULL)
        {
            cout << temp->data << "->";
            temp = temp->next;
        }
        cout << "NULL" << endl;
    }

    // Function to find the middle node of the linked list -- has node return type
    Node *middleLL()
    {
        Node* slow = head;
        Node* fast = head;

        while(fast != NULL && fast -> next!= NULL){
            slow = slow -> next;
            fast = fast -> next -> next;
        }
        cout << "Middle element: " << slow->data << endl;
        return slow;
    }
};
int main()
{
    List ll;
    ll.insert(1);
    ll.insert(2);
    ll.insert(3);
    ll.insert(4);
    // printing original Linked list
    ll.printLL();
    // return the node from the middle of the linked list
    Node *middle = ll.middleLL();

    while (middle != NULL)
    {
        cout << middle->data << "->";
        middle = middle->next;
    }
    cout << "NULL" << endl;

    return 0;
}
