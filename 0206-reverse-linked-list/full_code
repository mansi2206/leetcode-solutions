// Time Complexity - O(N)
// Space Complexity - O(1)

// Reverse a Linked List
// input -> ll = 1 2 3 NULL
// output -> 3 2 1 NULL

#include <iostream>
using namespace std;

class Node
{
public:
    int data;
    Node *next;

    Node(int val)
    {
        data = val;
        next = NULL;
    }
};

class List
{
public:
    Node *head;
    List()
    {
        head = NULL;
    }

    void insert(int val)
    {
        Node *newNode = new Node(val);

        if (head == NULL)
        {
            head = newNode;
            return;
        }
        Node *temp = head;
        while (temp->next != NULL)
        {
            temp = temp->next;
        }
        temp->next = newNode;
    }

    void printLL()
    {
        Node *temp = head;
        while (temp != NULL)
        {
            cout << temp->data << "->";
            temp = temp->next;
        }
        cout << "NULL" << endl;
    }

    void reverseLL()
    {
        Node *prevNode = NULL;
        Node *currNode = head;
        Node *nextNode = NULL;

        while (currNode != NULL)
        {
            nextNode = currNode->next;
            currNode->next = prevNode;

            prevNode = currNode;
            currNode = nextNode;
        }
        head = prevNode;
    }
};

int main()
{
    List ll;
    ll.insert(1);
    ll.insert(2);
    ll.insert(3);
    // printing original Linked list
    ll.printLL();
    ll.reverseLL();
    // printing reversed Linked list
    ll.printLL();

    return 0;
}
